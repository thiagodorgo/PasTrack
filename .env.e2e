# Variáveis do ambiente dos testes ponta a ponta.
#
# ATENÇÃO: todos os valores aqui são descartáveis e existem só para a suíte automatizada.
# Eles sobem um sistema isolado, em portas próprias, que é apagado ao fim dos testes.
# NUNCA use este arquivo numa instalação de verdade: para isso existe o .env.example.

POSTGRES_USER=pastrack
POSTGRES_PASSWORD=banco-de-testes-e2e
POSTGRES_DB=pastrack

JWT_SECRET=chave-descartavel-dos-testes-ponta-a-ponta-0123456789
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:8093,http://127.0.0.1:8093
BCRYPT_CUSTO=12
LOG_LEVEL=warn

# o administrador inicial nasce com troca obrigatória de senha, e a suíte exercita essa troca
SEED_ADMIN_EMAIL=admin@pastrack.local
# a senha não pode conter a parte do e-mail antes do @ ("admin"), nem ter menos de 12 caracteres
SEED_ADMIN_SENHA=PrimeiroAcessoE2E2026

# usuários de demonstração, um por perfil, já sem troca obrigatória
SEED_DEMO=true
SEED_DEMO_SENHA=DemoTesteE2E2026

# portas próprias: 8080, 8091, 8092, 5432, 5433, 5434, 5436 e 5437 são de outros ambientes
WEB_PORTA=8093
DB_PORTA=5438

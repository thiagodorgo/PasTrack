# Configuração do Docker Compose do PasTrack. Copie para .env e preencha. Nunca comite o arquivo .env.

# Usuário do PostgreSQL, criado na primeira subida do banco.
POSTGRES_USER=pastrack
# Senha do PostgreSQL (obrigatória). Use só letras, números, - e _, porque ela entra na URL de conexão da API.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
# Nome do banco de dados.
POSTGRES_DB=pastrack

# Chave que assina os tokens de login (obrigatória, com pelo menos 32 caracteres). Gere um valor novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade do token de login, em um formato como 8h, 30m ou 1d.
JWT_EXPIRES_IN=8h

# Origens do navegador autorizadas a chamar a API, separadas por vírgula.
# Pelo nginx, o site e a API ficam na mesma origem; mude só se o front-end rodar em outro endereço.
CORS_ORIGINS=http://localhost:8080
# Custo do bcrypt para as senhas: 12 ou mais em produção.
BCRYPT_CUSTO=12
# Nível dos logs da API: fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# E-mail do administrador inicial, criado na primeira subida da API.
SEED_ADMIN_EMAIL=admin@pastrack.local
# Senha do administrador: obrigatória na primeira subida, com 10 ou mais caracteres, letra e número.
# Depois que o administrador existe, mudar este valor não altera a senha dele.
SEED_ADMIN_SENHA=

# true carrega dados de demonstração (um usuário por perfil, fabricantes, fornecedores e pastilhas).
# Não use na instalação real da empresa.
SEED_DEMO=false
# Senha dos usuários de demonstração. Vazia: a primeira subida gera uma senha e a mostra no log da API.
SEED_DEMO_SENHA=

# Porta do site nesta máquina e na rede local (http://localhost:8080 ou http://<ip-desta-maquina>:8080).
WEB_PORTA=8080
# Porta do PostgreSQL, publicada só nesta máquina, para o modo de desenvolvimento.
DB_PORTA=5432

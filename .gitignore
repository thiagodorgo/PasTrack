node_modules/
dist/
build/
*.tsbuildinfo

# variáveis de ambiente (podem conter segredos)
.env
.env.*
!.env.example
!.env.*.example
# exceção: só valores descartáveis do ambiente dos testes ponta a ponta
!.env.e2e

# testes e cobertura (resultados versionados ficam em tests/results/<data>_<sha>/)
coverage/
tests/results/latest/
playwright-report/
test-results/
blob-report/
# sessões gravadas pelos testes ponta a ponta: contêm tokens de acesso
e2e/sessoes/

# logs
*.log
npm-debug.log*

# sistema operacional e editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

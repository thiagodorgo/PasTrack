# Copie para .env e ajuste. Nunca comite o arquivo .env.
NODE_ENV=development
PORT=3333
# 127.0.0.1 em vez de localhost: no Windows, localhost tenta ::1 primeiro e cada conexão nova atrasa cerca de 2 s.
DATABASE_URL="postgresql://pastrack:pastrack@127.0.0.1:5432/pastrack?schema=public"

# Obrigatório, com pelo menos 32 caracteres. Gere um valor novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origens do navegador autorizadas a chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
# Quantidade de proxies reversos na frente da API (1 atrás do nginx do Docker Compose).
TRUST_PROXY=0
# Custo do bcrypt: 12 ou mais em produção.
BCRYPT_CUSTO=12
LOG_LEVEL=info

# Força bruta no login: falhas permitidas por IP e e-mail dentro da janela (em minutos).
# Logins bem-sucedidos não contam. Ao estourar, a API responde 429 com o cabeçalho Retry-After.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_JANELA_MIN=15
# Requisições por minuto de cada IP em /api, antes da autenticação: só contra varredura.
# Deixe alto, porque vários postos da rede podem chegar à API pelo mesmo IP.
RATE_LIMIT_GLOBAL_MAX=1000
# Requisições por minuto de cada usuário autenticado.
RATE_LIMIT_USUARIO_MAX=300

# Administrador inicial criado por "npm run db:seed".
# Senha com 12 ou mais caracteres, letra e número. Vazia em desenvolvimento: o seed gera e exibe uma vez.
SEED_ADMIN_EMAIL=admin@pastrack.local
SEED_ADMIN_SENHA=

# Dados de demonstração criados por "npm run db:seed:demo" (só quando SEED_DEMO=true).
SEED_DEMO=false
SEED_DEMO_SENHA=
